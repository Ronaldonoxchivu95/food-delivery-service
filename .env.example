# ==== Общие ====
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==== PostgreSQL: restaurant-service ====
RESTAURANT_POSTGRES_USER=restaurant_user
RESTAURANT_POSTGRES_PASSWORD=restaurant_pass
RESTAURANT_POSTGRES_DB=restaurant_db
RESTAURANT_POSTGRES_HOST=postgres_restaurant
RESTAURANT_POSTGRES_PORT=5432
RESTAURANT_DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_pass@postgres_restaurant:5432/restaurant_db

# ==== PostgreSQL: order-service ====
ORDER_POSTGRES_USER=order_user
ORDER_POSTGRES_PASSWORD=order_pass
ORDER_POSTGRES_DB=order_db
ORDER_POSTGRES_HOST=postgres_order
ORDER_POSTGRES_PORT=5432
ORDER_DATABASE_URL=postgresql+asyncpg://order_user:order_pass@postgres_order:5432/order_db

# ==== RabbitMQ ====
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ==== Redis ====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60

# ==== Межсервисное взаимодействие ====
RESTAURANT_SERVICE_URL=http://restaurant-service:8000

# ==== Rate limiting (nginx) ====
NGINX_RATE_LIMIT=10r/s
